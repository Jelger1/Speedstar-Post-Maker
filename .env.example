# Kopieer naar .env voor lokaal draaien (wordt niet door de server gelezen —
# gebruik `set`/`export` of een tool als dotenv-cli) of vul in op Render.
OPENAI_API_KEY=sk-...
# Optioneel: gedeelde code die de tool moet meesturen
ACCESS_CODE=
# Elk OpenAI-chatmodel met structured outputs: gpt-4.1, gpt-4.1-mini, gpt-4o, ...
AI_MODEL=gpt-4.1
# Alleen voor redeneermodellen (o-serie, gpt-5): low | medium | high
# AI_REASONING=medium
# Extra origins die de API mogen aanroepen (bijv. VS Code Live Server):
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
RATE_LIMIT=30
# AI_MOCK=1
