# Omgevingsvariabelen voor server/server.js. Lokaal: zet ze in je shell
# (set/export) of gebruik een tool als dotenv-cli. Op Render: Environment.
OPENAI_API_KEY=sk-...
# Elk OpenAI-chatmodel met structured outputs: gpt-4.1, gpt-4.1-mini, gpt-4o, ...
AI_MODEL=gpt-4.1
# Alleen voor redeneermodellen (o-serie, gpt-5): low | medium | high
# AI_REASONING=medium
# Extra origins die de API mogen aanroepen (GitHub Pages en localhost mogen altijd):
ALLOWED_ORIGINS=https://jelger1.github.io
# Verzoeken per IP per 10 minuten
RATE_LIMIT=30
# Testen zonder OpenAI-aanroep (vaste voorstellen):
# AI_MOCK=1
